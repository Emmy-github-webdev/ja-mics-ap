{
  "info": {
    "name": "Payment Service API",
    "description": "Collection for testing Payment Service endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.dev.emmanuelogah.com"
    },
    {
      "key": "paymentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Create Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": 1001,\n  \"amount\": 250.50,\n  \"currency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Payment By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/payments/{{paymentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments",
            "{{paymentId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Payments",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        }
      },
      "response": []
    }
  ]
}